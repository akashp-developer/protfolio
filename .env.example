# Set to the full production origin on Vercel, e.g. https://your-domain.example
SITE_URL=
# Keep these values server-side. The sender must be from a Resend-verified domain.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Use a shared Upstash Redis database so limits apply across Vercel invocations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
